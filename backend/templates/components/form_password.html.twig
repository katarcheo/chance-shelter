<div class="form-group">
    <div style="display:flex; justify-content:space-between; align-items:center;">
        <label class="form-label" for="{{ id }}">{{ label }}</label>
        {% if forgot_link is defined and forgot_link %}
        <a href="{{ forgot_link }}" class="text-sm" style="color: var(--color-primary); text-decoration:none;"
           tabindex="-1">Forgot?</a>
        {% endif %}
    </div>
    <div class="input-wrapper">
        <input
            id="{{ id }}"
            name="{{ name }}"
            type="password"
            class="form-control{% if error is defined and error %} is-invalid{% endif %}"
            {% if autocomplete is defined %}autocomplete="{{ autocomplete }}"{% endif %}
            {% if placeholder is defined %}placeholder="{{ placeholder }}"{% endif %}
            {% if required is defined and required %}required{% endif %}
        >
        <button type="button" class="pwd-toggle" id="pwd-toggle"
                aria-label="Show password" aria-pressed="false">
            <svg id="eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
            </svg>
        </button>
    </div>
</div>